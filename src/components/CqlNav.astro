---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const items = [
  { href: '/cql-search/', label: 'Overview' },
  { href: '/cql-search/embed/', label: 'Embed a search' },
  { href: '/cql-search/queries/', label: 'Write a query' },
  { href: '/cql-search/export/', label: 'Export CSV' },
  { href: '/cql-search/use-cases/', label: 'Use cases' },
];
---
<nav class="sub" aria-label="CQL Search guides">
  {items.map((item) => (
    <a href={item.href} aria-current={path === item.href.replace(/\/$/, '') ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>
